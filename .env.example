# AI 模型配置
# 在 AI_PROVIDER 中选择提供商，然后配置对应的 API Key

# ===== 支持的提供商 =====
# deepseek    - DeepSeek（推荐，中文性价比最高）
# openai      - OpenAI (GPT-4o, GPT-4o-mini)
# anthropic   - Anthropic (Claude)
# moonshot    - 月之暗面 (Kimi)
# zhipu       - 智谱 AI (GLM)
# qwen        - 通义千问 (Qwen)
# siliconflow - 硅基流动
# ollama      - Ollama (本地模型)

AI_PROVIDER=deepseek

# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# ===== Anthropic (Claude) =====
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===== Moonshot (月之暗面) =====
MOONSHOT_API_KEY=sk-xxx
MOONSHOT_BASE_URL=https://api.moonshot.cn
MOONSHOT_MODEL=moonshot-v1-8k

# ===== 智谱 AI (GLM) =====
ZHIPU_API_KEY=xxx.xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ===== 通义千问 (Qwen) =====
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# ===== SiliconFlow (硅基流动) =====
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# ===== Ollama (本地) =====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Encryption =====
# AES-256 encryption key for API keys (64 hex chars, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=
